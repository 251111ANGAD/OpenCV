import cv2
import os
import numpy as np

cascade = cv2.CascadeClassifier("L9\\face_detector.xml")
folder = "L9\\images"

print("Recognising faces --> Please ensure sufficient lighting and that your face is clearly visible to the camera.")

images, labels, names, ids = ([], [], {}, 0)
#   Ensuring the images folder exists
if not os.path.exists(images) or not os.listdir(images):
    print("Error --> Image directory is empty or does not exist")
    exit()
#   Iterating through each person's folder
for person in os.listdir(images):
    path = os.path.join(images, person)
    if os.path.isdir(path):
        names[ids] = person
        for file in os.listdir(path):
            if file.endswith((".jpg", ".jpeg", ".png")):
                path_1 = os.path.join(path, file)
                img = cv2.imread(path_1, 0)
                images.append(img)
                labels.append(ids)
        ids += 1
width, height = 250, 250
images, labels = [np.array(i) for i in [images, labels]]
#   Train recogniser
recogniser = cv2.face.LBBHFaceRecognizer_create()
recogniser.train(images, labels)
#   Loading cascade
cascade_1 = cv2.CascadeClassifier(cascade)
#   Opening webcam
webcam = cv2.VideoCapture(0)
while True:
    success, frame = webcam.read()
    if not success:
        break
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    #   Detect faces
    faces = cascade_1.detectMultiScale(gray, 1.3, 5)
    for (x, y, w, h) in faces:
        cv2.rectangle(frame, (x, y), (x + w, y + h), (255, 0, 255), 2)
        face = gray[y:y + h, x:x + w]
        face_resized = cv2.resize(face, (width, height))
        #   Face recognision prediction
        prediction = recogniser.predict(face_resized)
        if prediction[1] < 100:
            cv2.putText(frame, f"{names[prediction[0]]} --> {prediction[1]:.0f}", (x, y-10), cv2.FONT_HERSHEY_PLAIN, 1, (0, 255, 0), 2)
        else:
            cv2.putText(frame, "Unknown", (x, y-10), cv2.FONT_HERSHEY_PLAIN, 1, (0, 255, 0), 2)
    cv2.imshow("L9-2", frame)
    key = cv2.waitKey(10)
    if key == 27:
        break
webcam.release()
cv2.destroyAllWindows()
